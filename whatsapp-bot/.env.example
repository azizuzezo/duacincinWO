# Salin file ini menjadi .env dan isi nilai sebenarnya. JANGAN commit .env asli.

# URL server API Go (lihat WHATSAPP_BOT_SECRET & WHATSAPP_BOT_CALLBACK_URL
# di .env root repo — WHATSAPP_BOT_SECRET harus sama persis di kedua sisi).
GO_API_URL=http://localhost:8080/api/v1
WHATSAPP_BOT_SECRET=

# Port & host tempat endpoint /deliver bot ini berjalan (dipanggil oleh Go
# API). 127.0.0.1 cukup kalau Go API & bot ini jalan di mesin yang sama.
PORT=8090
HOST=127.0.0.1

# Folder penyimpanan sesi login WhatsApp (hasil scan QR). Jangan commit.
AUTH_DIR=./auth_info_baileys
