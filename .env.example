# Salin file ini menjadi .env dan isi nilai sebenarnya. JANGAN commit .env asli.

# --- Database (Supabase) ---
DATABASE_POOLER=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- API server (Go) ---
PORT=8080
APP_ENV=development

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Fase 1+: Auth & OTP (Resend) ---
# JWT_SECRET & OTP_HMAC_SECRET: generate dengan `openssl rand -hex 32`
JWT_SECRET=
OTP_HMAC_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=DuaCincin <onboarding@resend.dev>
# Base URL publik untuk aset (logo) di email OTP, mis. https://duacincin.id
PUBLIC_ASSET_BASE_URL=

# --- Fase 6: Escrow Payment (Midtrans) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
